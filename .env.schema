# AymurAI deployment configuration. Values in this file are safe defaults;
# secrets belong in a gitignored .env.local or in the deployment secret store.
#
# @defaultRequired=false @defaultSensitive=false
# ---

# Optional deployment stage. When set, the backend also loads .env.<stage>.
STAGE=

# Comma-separated browser origins accepted by the API.
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080

# API and persistence.
# @type=port
API_PORT=8899
API_HOST=0.0.0.0
SQLALCHEMY_DATABASE_URI=sqlite:////resources/cache/sqlite/database.db
# @type=number
SQLITE_BUSY_TIMEOUT_MS=5000
RESOURCES_BASEPATH=/resources
AYMURAI_CACHE_BASEPATH=/resources/cache
# @type=number
MEMORY_CACHE_MAXSIZE=4
# @type=number
TORCH_NUM_THREADS=4
TORCH_DEVICE=cpu

# Defensoria distribution gate. The Docker build maps this same value to the
# frontend's VITE_DEFENSORIA_ENABLED build-time flag.
# @type=boolean
DEFENSORIA_ENABLED=false

# llama.cpp server used by summarization and Defensoria extraction.
# @required
LLAMACPP_MODEL_FILE=
LLAMACPP_MODELS_DIR=~/.llama.cpp/models
# @type=number
LLAMACPP_CTX_SIZE=65536
# @type=url
LLAMACPP_BASE_URL=http://llamacpp:8080/v1
# @sensitive
LLAMACPP_API_KEY=not-needed
# Optional application-side cap; blank means use the server's n_ctx.
# @type=number
LLM_MAX_CONTEXT_TOKENS=
# @type=number
LLM_DEFAULT_MAX_TOKENS=4096
# @type=number
LLM_CHUNK_OVERLAP_TOKENS=128

# Defensoria extraction generation and matching.
# @type=number
DATA_EXTRACTION_MAX_TOKENS=1024
# @type=number
DATA_EXTRACTION_MAX_RETRIES=2
# @type=enum(fuzzy, embeddings, hybrid)
DATA_EXTRACTION_SEARCH_BACKEND=hybrid
# @type=number
DATA_EXTRACTION_TOP_K=5
# @type=number
DATA_EXTRACTION_HYBRID_WEIGHT=0.25
# @type=number
DATA_EXTRACTION_NAME_EVIDENCE_WEIGHT=1.0
# @type=number
DATA_EXTRACTION_NAME_SCORE_THRESHOLD=90
# @type=number
DATA_EXTRACTION_POSITION_SCORE_THRESHOLD=85
EXPORT_TIMEZONE=America/Argentina/Buenos_Aires

# Optional ASR sidecar.
TRANSCRIBE_BASE_URL=http://coro:8000/v1
# @sensitive
TRANSCRIBE_API_KEY=not-needed
CORO_VERSION=1.0.5
# @type=enum(onnx-asr, faster-whisper)
CORO_BACKEND_ASR=onnx-asr
CORO_MODEL_ASR=nemo-canary-1b-v2
CORO_BACKEND_ASR_GPU=faster-whisper
CORO_MODEL_ASR_GPU=openai/whisper-medium
CORO_BACKEND_DIARIZATION=nemo

# SQLite backup sidecar.
BACKUP_SOURCE_DB=/resources/cache/sqlite/database.db
BACKUP_DEST_DIR=/backups
# @type=number
BACKUP_INTERVAL_SECONDS=3600
# @type=number
BACKUP_RETENTION=336
