{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/build",
      "!**/dist",
      "!**/.husky",
      "!**/out",
      "!**/routeTree.gen.ts",
      "!**/src/renderer/src/styled",
      "!**/playwright/.cache",
      "!**/playwright-report",
      "!**/test-results",
      "!.worktrees",
      "!**/.claude/settings.local.json",
      "!**/.orquestalite",
      "!**/tasks",
      "!**/team.json",
      "!**/flows.json",
      "!**/prompts",
      "!**/schemas"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "performance": {
        "noAccumulatingSpread": "warn",
        "noDelete": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      },
      "complexity": {
        "noUselessSwitchCase": "off",
        "noForEach": "off",
        "noUselessFragments": "off",
        "noBannedTypes": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useSelfClosingElements": {
          "fix": "safe",
          "level": "error"
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@stitches/react": "Stitches has been fully migrated to Panda CSS (RSP-12b). Import from `@/styled/css` or `@/styled/jsx` instead.",
              "react-router-dom": "This app uses TanStack Router, not react-router-dom."
            }
          }
        }
      },
      "nursery": {},
      "suspicious": {
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": [
              "error",
              "warn",
              "info",
              "debug",
              "trace",
              "assert",
              "table",
              "group",
              "groupEnd"
            ]
          }
        }
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "warn",
        "useSemanticElements": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
