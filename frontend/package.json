{
  "name": "aymurai",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev:web": "cross-env VITE_APP_MODE=web vite --config vite.config.ts",
    "dev": "cross-env VITE_APP_MODE=electron electron-vite dev",
    "start": "cross-env VITE_APP_MODE=electron electron-vite preview",
    "start:web": "cross-env VITE_APP_MODE=web vite preview --config vite.config.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format",
    "format:fix": "biome format --write",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "validate": "pnpm lint && pnpm typecheck",
    "postinstall": "electron-builder install-app-deps || true",
    "panda:codegen": "panda codegen",
    "prepare": "panda codegen",
    "build:web": "cross-env VITE_APP_MODE=web vite build --config vite.config.ts",
    "build": "pnpm run typecheck && cross-env VITE_APP_MODE=electron electron-vite build",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "cross-env VITE_APP_MODE=electron electron-vite build && electron-builder --mac",
    "build:linux": "cross-env VITE_APP_MODE=electron electron-vite build && electron-builder --linux",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:responsive": "playwright test --config=playwright-ct.config.ts",
    "test:visual": "playwright test --config=playwright-ct.config.ts visual-capture"
  },
  "dependencies": {
    "@aymurai/ui": "github:AymurAI/ui-components#v0.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@pandacss/dev": "^2.2.0",
    "@pandacss/preset-panda": "^2.2.0",
    "@playwright/experimental-ct-react": "1.62.1",
    "@playwright/test": "1.64.0",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.45",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/regex-escape": "^3.4.1",
    "@vitejs/plugin-react": "^6.1.2",
    "axios": "^1.20.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-debug": "^4.1.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "exceljs": "^4.4.0",
    "i18next": "^26.4.4",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "markdownlint-cli": "^0.49.1",
    "nodemon": "^3.1.14",
    "phosphor-react": "^1.4.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^17.0.16",
    "regex-escape": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wait-on": "^9.5.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=22.13"
  }
}
